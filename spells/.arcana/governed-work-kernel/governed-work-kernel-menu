#!/bin/sh

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: governed-work-kernel-menu

Shows Governed Work Kernel install and status actions.
USAGE
  exit 0
  ;;
esac

set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}
export PATH
script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
. "$script_dir/_kernel"

if ! command -v menu >/dev/null 2>&1; then
  "$script_dir/governed-work-kernel-status"
  exit 0
fi

trap 'exit 130' INT
trap 'exit 0' TERM

while true; do
  if is_kernel_installed; then
    toggle="[X] Governed Work Kernel%$script_dir/install-governed-work-kernel"
  else
    toggle="[ ] Governed Work Kernel%$script_dir/install-governed-work-kernel"
  fi
  exit_label=$(exit-label 2>/dev/null || printf 'Exit')
  menu_status=0
  menu "Governed Work Kernel" \
    "$toggle" \
    "Check status%$script_dir/check-governed-work-kernel" \
    "Show details%$script_dir/governed-work-kernel-status" \
    "Uninstall%$script_dir/uninstall-governed-work-kernel" \
    "$exit_label%kill -TERM \$PPID" || menu_status=$?
  [ "$menu_status" -eq 130 ] && exit 0
done
