#!/bin/sh

case "${1-}" in
--help|--usage|-h)
  cat <<'USAGE'
Usage: install-governed-work-kernel

Installs the external Governed Work Kernel dependency.

The upstream source is AGPL-3.0-or-later and remains separately licensed. This
installer clones and builds that external workspace; it does not vendor the
kernel source into Wizardry or Artificer.
USAGE
  exit 0
  ;;
esac

set -eu
script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
. "$script_dir/_kernel"

if ! has_cmd git; then
  say "install-governed-work-kernel: git is required." >&2
  exit 1
fi

clone_or_update_source
write_kernel_wrapper
build_kernel_workspace

say "Installed $kernel_name"
say "Source: $(kernel_source_dir)"
say "Executable: $(kernel_bin_path)"
say "License: AGPL-3.0-or-later (external dependency)"
